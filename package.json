{
  "name": "family-todo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "web": "expo start --web",
    "dev": "bunx expo start -c",
    "development": "EXPO_PUBLIC_APP_VARIANT=development bunx expo start -c",
    "staging": "EXPO_PUBLIC_APP_VARIANT=staging bunx expo start -c",
    "staging:android": "EXPO_PUBLIC_APP_VARIANT=staging bunx expo start -c --android",
    "dev:android": "EXPO_PUBLIC_APP_VARIANT=development bunx expo start -c --android",
    "prebuild:dev": "EXPO_PUBLIC_APP_VARIANT=development npx expo prebuild",
    "prebuild:dev:ios": "EXPO_PUBLIC_APP_VARIANT=development bunx expo prebuild --platform ios",
    "prebuild:stg": "EXPO_PUBLIC_APP_VARIANT=staging npx expo prebuild",
    "prebuild:prod": "EXPO_PUBLIC_APP_VARIANT=production npx expo prebuild --clean",
    "android:debug:dev": "EXPO_PUBLIC_APP_VARIANT=development bunx expo run:android",
    "android:debug:staging": "EXPO_PUBLIC_APP_VARIANT=staging bunx expo run:android",
    "android:debug:prod": "EXPO_PUBLIC_APP_VARIANT=production bunx expo run:android",
    "ios": "bunx expo run:ios",
    "ios:debug:dev": "EXPO_PUBLIC_APP_VARIANT=development bunx expo run:ios",
    "ios:debug:prod": "EXPO_PUBLIC_APP_VARIANT=production bunx expo run:ios",
    "ios:debug:staging": "EXPO_PUBLIC_APP_VARIANT=staging bunx expo run:ios",
    "eas:build:local:android:staging": "eas build --profile preview --platform android --local",
    "eas:build:local:android:prod": "eas build --profile production --platform android --local",
    "eas:build:local:android:dev": "eas build --profile development --platform android --local",
    "android": "expo run:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "^2.11.4",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.101.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.33",
    "expo-apple-authentication": "^55.0.13",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.22",
    "expo-haptics": "^55.0.14",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "^55.0.13",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "posthog-react-native": "^4.44.0",
    "posthog-react-native-session-replay": "^1.5.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^3.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
